# Copy this file to .env and fill in your own values.

# Postgres connection string. If you install Postgres locally, it usually
# looks like this (adjust user/password/db name to what you set up):
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/health_console?schema=public"

# Port the API server listens on
PORT=4000

# Origin your frontend runs on, for CORS
FRONTEND_ORIGIN="http://localhost:3000"
